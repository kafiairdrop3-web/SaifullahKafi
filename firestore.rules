rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function: check if the user is signed in (Admin user)
    function isAdmin() {
      return request.auth != null;
    }

    // Public read-only access to 'videos' and 'tags'; write restricted to Admin
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
